<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111318">

    <!-- Écran Principal -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Barre Supérieure (Header) -->
        <LinearLayout
            android:id="@+id/header_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="#1B1D24">

            <ImageButton
                android:id="@+id/btn_open_drawer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="#E2E2E9"/>

            <TextView
                android:id="@+id/tv_current_model"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="KRUX 3.3 70B"
                android:textColor="#E2E2E9"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingStart="12dp"/>

            <ImageButton
                android:id="@+id/btn_new_chat"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_input_add"
                app:tint="#E2E2E9"/>
        </LinearLayout>

        <!-- Vue d'Accueil Centrée (Style Gemini - Masquée quand la discussion commence) -->
        <LinearLayout
            android:id="@+id/welcome_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/header_bar"
            android:layout_above="@+id/input_container"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bonjour 👋"
                android:textColor="#A8C7FA"
                android:textSize="32sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Que souhaitez-vous explorer ou créer aujourd'hui ?"
                android:textColor="#C4C6D0"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="32dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/chip_code"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💻 Écrire un script"
                    android:textColor="#E2E2E9"
                    android:backgroundTint="#282A36"
                    android:layout_marginEnd="6dp"/>

                <Button
                    android:id="@+id/chip_media"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🎥 Vidéos & Médias"
                    android:textColor="#E2E2E9"
                    android:backgroundTint="#282A36"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Liste des Messages du Chat -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_chat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/header_bar"
            android:layout_above="@+id/input_container"
            android:visibility="gone"
            android:padding="12dp"/>

        <!-- Input Texte & Actions -->
        <LinearLayout
            android:id="@+id/input_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="horizontal"
            android:padding="12dp"
            android:background="#1B1D24">

            <EditText
                android:id="@+id/et_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Posez une question ou demandez un média..."
                android:textColorHint="#8E9099"
                android:textColor="#FFFFFF"
                android:background="@null"
                android:maxLines="4"
                android:padding="8dp"/>

            <ImageButton
                android:id="@+id/btn_send"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_send"
                app:tint="#A8C7FA"/>
        </LinearLayout>
    </RelativeLayout>

    <!-- Menu Hamburger Drawer (Historique + Recherche) -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#1E202A">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Conversations KRUX"
                android:textColor="#E2E2E9"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <!-- Barre de Recherche dans l'Historique -->
            <EditText
                android:id="@+id/et_search_history"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:hint="🔍 Rechercher un chat..."
                android:textColorHint="#8E9099"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:background="#282A36"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="16dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_history"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
        </LinearLayout>
    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>
