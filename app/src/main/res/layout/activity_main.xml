<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07050F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- HEADER KRUX -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <!-- Bulle hamburger -->
            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_header_bubble"
                android:padding="11dp"
                android:src="@drawable/ic_menu"
                android:contentDescription="Menu" />

            <!-- Capsule Krux -->
            <LinearLayout
                android:id="@+id/kruxModelCapsule"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:layout_toEndOf="@id/btnMenu"
                android:background="@drawable/bg_krux_capsule"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvKruxName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Krux"
                    android:textColor="#FAF7FF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSelectedModel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:maxWidth="130dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="3.5 Flash"
                    android:textColor="#B9AFCB"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvTokenRemaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="1M"
                    android:textColor="#766A8A"
                    android:textSize="10sp"
                    android:maxLines="1" />

                <ImageView
                    android:id="@+id/ivModelArrow"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_arrow_down"
                    android:tint="#B9AFCB" />

            </LinearLayout>

            <!-- Compte -->
            <ImageButton
                android:id="@+id/btnAccount"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_header_bubble"
                android:padding="10dp"
                android:src="@drawable/ic_account"
                android:contentDescription="Compte" />

        </RelativeLayout>

        <!-- Zone Chat + Boutons Flottants -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvChat"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp" />

            <!-- Bouton flottant TTS (Pause / Play vocal) en haut à droite -->
            <ImageButton
                android:id="@+id/btnTtsControl"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_send_button"
                android:contentDescription="Contrôle vocal IA"
                android:elevation="4dp"
                android:src="@drawable/ic_pause"
                android:tint="#07050F"
                android:visibility="gone" />

            <!-- Bouton Défilement Flottant -->
            <ImageButton
                android:id="@+id/btnScrollBottom"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_send_button"
                android:contentDescription="Défiler vers le bas"
                android:src="@drawable/ic_arrow_down"
                android:tint="#07050F"
                android:visibility="gone" />
        </RelativeLayout>

        <!-- Zone de saisie flottante moderne -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#07050F"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp">

                <!-- Bouton Plus (Inchangé) -->
                <ImageButton
                    android:id="@+id/btnPlus"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_plus" />

                <!-- Zone d'écriture -->
                <EditText
                    android:id="@+id/etInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Message KruxAI..."
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="6"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="8dp"
                    android:textColor="#FAF7FF"
                    android:textColorHint="#766A8A"
                    android:textSize="15sp" />

                <!-- Ondes vocales animées (Affichées pendant l'écoute) -->
                <LinearLayout
                    android:id="@+id/llVoiceVisualizer"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <View
                        android:id="@+id/waveBar1"
                        android:layout_width="4dp"
                        android:layout_height="16dp"
                        android:layout_marginHorizontal="3dp"
                        android:background="#A855F7" />
                    <View
                        android:id="@+id/waveBar2"
                        android:layout_width="4dp"
                        android:layout_height="28dp"
                        android:layout_marginHorizontal="3dp"
                        android:background="#A855F7" />
                    <View
                        android:id="@+id/waveBar3"
                        android:layout_width="4dp"
                        android:layout_height="20dp"
                        android:layout_marginHorizontal="3dp"
                        android:background="#A855F7" />
                    <View
                        android:id="@+id/waveBar4"
                        android:layout_width="4dp"
                        android:layout_height="32dp"
                        android:layout_marginHorizontal="3dp"
                        android:background="#A855F7" />
                </LinearLayout>

                <!-- Bouton Micro -->
                <ImageButton
                    android:id="@+id/btnMic"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_mic" />

                <!-- Bouton Carré d'Arrêt Enregistrement -->
                <ImageButton
                    android:id="@+id/btnStopMic"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_send_button"
                    android:src="@drawable/ic_stop"
                    android:tint="#07050F"
                    android:visibility="gone" />

                <!-- Bouton Envoi -->
                <ImageButton
                    android:id="@+id/btnSend"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_send_button_round"
                    android:src="@drawable/ic_send"
                    android:tint="#07050F" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:text="KruxAI peut commettre des erreurs. Vérifiez les informations."
                android:textColor="#665A7A"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <include
        layout="@layout/layout_sidebar"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />
</androidx.drawerlayout.widget.DrawerLayout>
