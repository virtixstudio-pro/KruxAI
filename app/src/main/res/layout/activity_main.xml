<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout android:tag="krux:bg"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07050F">

    <!-- =====================================================
         CONTENU PRINCIPAL
         ===================================================== -->

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- =================================================
             ZONE CHAT / ACCUEIL
             ================================================= -->

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvChat"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="12dp"
                android:fadingEdgeLength="36dp"
                android:paddingTop="72dp"
                android:paddingBottom="140dp"
                android:requiresFadingEdge="vertical"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/offlineBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="70dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:textSize="13sp"
                android:visibility="gone" />


            <!-- =================================================
                 MESSAGE D'ACCUEIL
                 ================================================= -->

            <LinearLayout
                android:id="@+id/welcomePanel"
                
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_marginHorizontal="24dp"
                
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:id="@+id/tvWelcomeTitle"
                    android:tag="krux:text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bonjour"
                    android:textColor="#FAF7FF"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvWelcomeSubtitle"
                    android:tag="krux:text2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:gravity="center"
                    android:text="Prêt à commencer quelque chose ?"
                    android:textColor="#B9AFCB"
                    android:textSize="14sp" />




            </LinearLayout>


            <!-- TTS -->

            <ImageButton android:tag="krux:button,buttontext"
                android:id="@+id/btnTtsControl"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="76dp"
                android:background="@drawable/bg_send_button"
                android:contentDescription="Contrôle vocal IA"
                android:elevation="4dp"
                android:src="@drawable/ic_pause"
                android:tint="#07050F"
                android:visibility="gone" />


            <!-- RETOUR EN BAS -->

            <ImageButton android:tag="krux:button,buttontext"
                android:id="@+id/btnScrollBottom"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="150dp"
                android:background="@drawable/bg_send_button"
                android:contentDescription="Défiler vers le bas"
                android:src="@drawable/ic_arrow_down"
                android:tint="#07050F"
                android:visibility="gone" />

        </RelativeLayout>





        <!-- HEADER -->

        <RelativeLayout
            android:id="@+id/headerBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_alignParentTop="true"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageButton android:tag="krux:input"
                android:id="@+id/btnMenu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_header_bubble"
                android:contentDescription="Menu"
                android:padding="11dp"
                android:src="@drawable/ic_menu" />

            <LinearLayout android:tag="krux:input"
                android:id="@+id/kruxModelCapsule"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:layout_toEndOf="@id/btnMenu"
                android:background="@drawable/bg_krux_capsule"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="11dp">

                <TextView android:tag="krux:text"
                    android:id="@+id/tvKruxName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Krux"
                    android:textColor="#FAF7FF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView android:tag="krux:text2"
                    android:id="@+id/tvSelectedModel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:maxWidth="130dp"
                    android:text="3.5 Flash"
                    android:textColor="#B9AFCB"
                    android:textSize="12sp" />

                <TextView android:tag="krux:text2"
                    android:id="@+id/tvTokenRemaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="1M"
                    android:textColor="#766A8A"
                    android:textSize="10sp" />

                <ImageView android:tag="krux:text2"
                    android:id="@+id/ivModelArrow"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_arrow_down"
                    android:tint="#B9AFCB" />

            </LinearLayout>



        </RelativeLayout>


        <com.virtixstudio.kruxai.ui.KruxTerminalView
            android:id="@+id/kruxTerminal"
            android:layout_above="@+id/composerBar"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone" />

        <!-- =================================================
             COMPOSER
             ================================================= -->

        <LinearLayout
            android:id="@+id/composerBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="@android:color/transparent"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="12dp">

            <LinearLayout android:tag="krux:input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp">

                <ImageButton
                    android:id="@+id/btnPlus"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_plus" />

                <EditText android:tag="krux:text,hint"
                    android:id="@+id/etInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Message Krux..."
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="6"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="8dp"
                    android:textColor="#FAF7FF"
                    android:textColorHint="#766A8A"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/llVoiceVisualizer"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <View android:tag="krux:button"
                        android:id="@+id/waveBar1"
                        android:layout_width="4dp"
                        android:layout_height="16dp"
                        android:layout_marginHorizontal="3dp"
                        android:background="#A855F7" />

                    <View android:tag="krux:button"
                        android:id="@+id/waveBar2"
                        android:layout_width="4dp"
                        android:layout_height="28dp"
                        android:layout_marginHorizontal="3dp"
                        android:background="#A855F7" />

                    <View android:tag="krux:button"
                        android:id="@+id/waveBar3"
                        android:layout_width="4dp"
                        android:layout_height="20dp"
                        android:layout_marginHorizontal="3dp"
                        android:background="#A855F7" />

                    <View android:tag="krux:button"
                        android:id="@+id/waveBar4"
                        android:layout_width="4dp"
                        android:layout_height="32dp"
                        android:layout_marginHorizontal="3dp"
                        android:background="#A855F7" />

                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnMic"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_mic" />

                <ImageButton android:tag="krux:button,buttontext"
                    android:id="@+id/btnStopMic"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_send_button"
                    android:src="@drawable/ic_stop"
                    android:tint="#07050F"
                    android:visibility="gone" />

                <ImageButton android:tag="krux:button,buttontext"
                    android:id="@+id/btnSend"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_send_button_round"
                    android:src="@drawable/ic_send"
                    android:tint="#07050F" />

            </LinearLayout>

            <TextView android:tag="krux:text2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:text="Krux peut commettre des erreurs. Vérifiez les informations."
                android:textColor="#665A7A"
                android:textSize="11sp" />

        </LinearLayout>

    </RelativeLayout>


    <!-- =====================================================
         DRAWER — DOIT RESTER EN DERNIER
         ===================================================== -->

    <include
        layout="@layout/layout_sidebar"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>
