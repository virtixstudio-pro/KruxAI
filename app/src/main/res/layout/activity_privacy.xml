<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:tag="krux:bg" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="48dp"
            android:paddingEnd="24dp"
            android:paddingBottom="28dp">

            <TextView android:tag="krux:text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Avant de commencer"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView android:tag="krux:text2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Quelques mots sur tes données, en clair."
                android:textColor="#8A8A8A"
                android:textSize="14sp" />

            <LinearLayout android:tag="krux:input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_rounded_card"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView android:tag="krux:text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ce que KRUX conserve"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView android:tag="krux:text2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Ton prénom et ton e-mail pour le compte. Tes discussions, tes souvenirs et tes apps, synchronisés sur ton compte pour les retrouver sur un autre téléphone."
                    android:textColor="#B0B0B0"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout android:tag="krux:input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_rounded_card"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView android:tag="krux:text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ce qui est envoyé à l'IA"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView android:tag="krux:text2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Tes messages sont envoyés à des fournisseurs d'IA pour produire les réponses. N'écris jamais de mot de passe ni d'information très sensible."
                    android:textColor="#B0B0B0"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout android:tag="krux:input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_rounded_card"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView android:tag="krux:text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ce que tu contrôles"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView android:tag="krux:text2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Tu choisis ce que KRUX retient dans Mémoire, et tu peux supprimer tes discussions. La lecture de l'écran ne se fait que si tu l'actives et que tu le demandes."
                    android:textColor="#B0B0B0"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout android:tag="krux:input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_rounded_card"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView android:tag="krux:text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="À savoir"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView android:tag="krux:text2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="KRUX peut se tromper. Vérifie les informations importantes avant de t'y fier."
                    android:textColor="#B0B0B0"
                    android:textSize="13sp" />
            </LinearLayout>

            <CheckBox android:tag="krux:text"
                android:id="@+id/cbAcceptPrivacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="J'ai lu et j'accepte"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Button android:tag="krux:button,buttontext"
                android:id="@+id/btnAcceptPrivacy"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_rounded_button"
                android:text="Accepter et créer mon compte"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView android:tag="krux:text2"
                android:id="@+id/tvPrivacyBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:padding="8dp"
                android:text="Retour"
                android:textColor="#8A8A8A"
                android:textSize="14sp" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
