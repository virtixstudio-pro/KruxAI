<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="250dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:background="@drawable/bg_rounded_input"
    android:backgroundTint="#151020"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="11dp">

    <TextView
        android:id="@+id/tvDomain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#BFA8D6"
        android:textSize="10sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#F8F5FF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/tvSnippet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textColor="#9E93AD"
        android:textSize="11sp"
        android:lineSpacingExtra="1dp"
        android:maxLines="3"
        android:ellipsize="end" />

    <!-- La preview visuelle est volontairement EN BAS -->
    <ImageView
        android:id="@+id/ivPreview"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_marginTop="9dp"
        android:background="#0E0A17"
        android:contentDescription="Aperçu de la source"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_globe"
        android:tint="#9B7AB8" />

</LinearLayout>
