<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <ImageView
            android:id="@+id/kruxSplashHead"
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:contentDescription="KRUX"
            android:src="@drawable/krux_splash_head"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tvIntelligence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="INTELLIGENCE"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.18" />

        <TextView
            android:id="@+id/tvWithoutLimits"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="SANS LIMITE"
            android:textColor="#5EBBFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.16" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvSplashCopyright"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:text="© Virtix Studio · 2026"
        android:textColor="#666666"
        android:textSize="11sp" />

</FrameLayout>
