<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#111318">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Options"
        android:textColor="#F8FAFC"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/optLearning"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:text="Mode Apprentissage"
        android:textColor="#F8FAFC"
        android:textSize="15sp"
        android:background="?attr/selectableItemBackground" />

    <TextView
        android:id="@+id/optDeepSearch"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:text="Recherche Web Temps Réel"
        android:textColor="#F8FAFC"
        android:textSize="15sp"
        android:background="?attr/selectableItemBackground" />

    <TextView
        android:id="@+id/optThinking"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:text="Mode Réflexion"
        android:textColor="#F8FAFC"
        android:textSize="15sp"
        android:background="?attr/selectableItemBackground" />

    <TextView
        android:id="@+id/optFiles"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:text="📎  Fichiers"
        android:textColor="#F8FAFC"
        android:textSize="15sp"
        android:background="?attr/selectableItemBackground" />

</LinearLayout>
