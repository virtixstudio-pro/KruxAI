<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1E293B"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_wrap"
        android:text="Paramètres du compte"
        android:textColor="#F8FAFC"
        android:textSize="18sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="#334155" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_wrap"
        android:text="Synthèse vocale (TTS)"
        android:textColor="#94A3B8"
        android:textSize="14sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgTtsEngine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <RadioButton
            android:id="@+id/rbTtsLocal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Voix Système Locale (Hors-ligne / Instantané)"
            android:textColor="#F8FAFC"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rbTtsCloud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voix IA Cloud (Haute Qualité)"
            android:textColor="#F8FAFC"
            android:textSize="13sp" />
    </RadioGroup>

</LinearLayout>
