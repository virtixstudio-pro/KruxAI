<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- Poignée de glissement (Drag handle) -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#334155"
        android:layout_marginBottom="20dp"
        android:backgroundTint="#475569" />

    <!-- Avatar Cercle -->
    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_rounded_input"
        android:backgroundTint="#1E293B"
        android:layout_marginBottom="12dp"
        android:gravity="center">

        <TextView
            android:id="@+id/tvAvatarLetter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="U"
            android:textColor="#38BDF8"
            android:textSize="28sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Email Utilisateur -->
    <TextView
        android:id="@+id/tvUserEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="utilisateur@kruxai.com"
        android:textColor="#F8FAFC"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Compte Google / Firebase actif"
        android:textColor="#64748B"
        android:textSize="12sp"
        android:layout_marginBottom="24dp" />

    <!-- Carte d'options -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E293B"
        android:orientation="vertical"
        android:padding="4dp"
        android:layout_marginBottom="20dp"
        android:outlineSpotShadowColor="#000000">

        <Button
            android:id="@+id/btnMemory"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="?attr/selectableItemBackground"
            android:text="🧠 Gérer la mémoire de l'IA"
            android:textColor="#F8FAFC"
            android:textSize="14sp"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:textAllCaps="false" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#334155"
            android:layout_marginHorizontal="16dp" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="?attr/selectableItemBackground"
            android:text="⚙️ Paramètres et Thèmes"
            android:textColor="#F8FAFC"
            android:textSize="14sp"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:textAllCaps="false" />
    </LinearLayout>

    <!-- Bouton Déconnexion dans la modale -->
    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:backgroundTint="#7F1D1D"
        android:text="Se déconnecter"
        android:textColor="#FCA5A5"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textAllCaps="false" />

</LinearLayout>
