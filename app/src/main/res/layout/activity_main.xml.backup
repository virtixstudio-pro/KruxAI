<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- En-tête -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_menu" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="KruxAI"
                android:textColor="#F8FAFC"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnAccount"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_account" />
        </LinearLayout>

        <!-- Zone Chat + Boutons Flottants -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvChat"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp" />

            <!-- Bouton flottant TTS (Pause / Play vocal) en haut à droite -->
            <ImageButton
                android:id="@+id/btnTtsControl"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_send_button"
                android:contentDescription="Contrôle vocal IA"
                android:elevation="4dp"
                android:src="@drawable/ic_pause"
                android:tint="#0F172A"
                android:visibility="gone" />

            <!-- Bouton Défilement Flottant -->
            <ImageButton
                android:id="@+id/btnScrollBottom"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_send_button"
                android:contentDescription="Défiler vers le bas"
                android:src="@drawable/ic_arrow_down"
                android:tint="#0F172A"
                android:visibility="gone" />
        </RelativeLayout>

        <!-- Zone de saisie flottante moderne -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0F172A"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp">

                <!-- Bouton Plus (Inchangé) -->
                <ImageButton
                    android:id="@+id/btnPlus"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_plus" />

                <!-- Zone d'écriture -->
                <EditText
                    android:id="@+id/etInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Message KruxAI..."
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="6"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="8dp"
                    android:textColor="#F8FAFC"
                    android:textColorHint="#64748B"
                    android:textSize="15sp" />

                <!-- Ondes vocales animées (Affichées pendant l'écoute) -->
                <LinearLayout
                    android:id="@+id/llVoiceVisualizer"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <View
                        android:id="@+id/waveBar1"
                        android:layout_width="4dp"
                        android:layout_height="16dp"
                        android:layout_marginHorizontal="3dp"
                        android:background="#38BDF8" />
                    <View
                        android:id="@+id/waveBar2"
                        android:layout_width="4dp"
                        android:layout_height="28dp"
                        android:layout_marginHorizontal="3dp"
                        android:background="#38BDF8" />
                    <View
                        android:id="@+id/waveBar3"
                        android:layout_width="4dp"
                        android:layout_height="20dp"
                        android:layout_marginHorizontal="3dp"
                        android:background="#38BDF8" />
                    <View
                        android:id="@+id/waveBar4"
                        android:layout_width="4dp"
                        android:layout_height="32dp"
                        android:layout_marginHorizontal="3dp"
                        android:background="#38BDF8" />
                </LinearLayout>

                <!-- Bouton Micro -->
                <ImageButton
                    android:id="@+id/btnMic"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_mic" />

                <!-- Bouton Carré d'Arrêt Enregistrement -->
                <ImageButton
                    android:id="@+id/btnStopMic"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_send_button"
                    android:src="@drawable/ic_stop"
                    android:tint="#0F172A"
                    android:visibility="gone" />

                <!-- Bouton Envoi -->
                <ImageButton
                    android:id="@+id/btnSend"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_send_button"
                    android:src="@drawable/ic_send"
                    android:tint="#0F172A" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:text="KruxAI peut commettre des erreurs. Vérifiez les informations."
                android:textColor="#475569"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <include
        layout="@layout/layout_sidebar"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />
</androidx.drawerlayout.widget.DrawerLayout>
