<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:tag="krux:bg" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="160dp"
    android:background="#07050F"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView android:tag="krux:accent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="KRUX AI"
        android:textColor="#A855F7"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView android:tag="krux:text2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Virtix Studio 2026"
        android:textColor="#B9AFCB"
        android:textSize="14sp" />
</LinearLayout>
