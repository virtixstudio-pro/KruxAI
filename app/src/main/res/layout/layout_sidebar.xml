<?xml version="1.0" encoding="utf-8"?>

<LinearLayout android:tag="krux:bg" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="#090611"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="18dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <!-- EN-TETE -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView android:tag="krux:text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="10dp"
            android:text="Krux"
            android:textColor="#FAF7FF"
            android:textSize="21sp"
            android:textStyle="bold" />

        <ImageButton android:tag="krux:text2"
            android:id="@+id/btnCloseSidebar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Fermer"
            android:padding="9dp"
            android:src="@drawable/ic_line_close"
            android:tint="#B9AFCB" />

    </LinearLayout>


    <!-- ACTION PRINCIPALE : le seul bouton plein du menu -->

    <TextView android:tag="krux:button,buttontext"
        android:id="@+id/btnNewChat"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_rounded_input"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="+   Nouveau chat"
        android:textColor="#000000"
        android:textSize="15sp"
        android:textStyle="bold" />


    <!-- NAVIGATION : une liste simple, une icône différente par entrée -->

    <LinearLayout
        android:id="@+id/navMyApps"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <ImageView android:tag="krux:text2"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="14dp"
            android:src="@drawable/ic_line_apps"
            android:tint="#B9AFCB" />

        <TextView android:tag="krux:text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mes apps"
            android:textColor="#FAF7FF"
            android:textSize="15sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/navFiles"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <ImageView android:tag="krux:text2"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="14dp"
            android:src="@drawable/ic_line_folder"
            android:tint="#B9AFCB" />

        <TextView android:tag="krux:text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Fichiers"
            android:textColor="#FAF7FF"
            android:textSize="15sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/navKruxCode"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <ImageView android:tag="krux:text2"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="14dp"
            android:src="@drawable/ic_line_code"
            android:tint="#B9AFCB" />

        <TextView android:tag="krux:text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Krux Code"
            android:textColor="#FAF7FF"
            android:textSize="15sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/navStudio"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <ImageView android:tag="krux:text2"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="14dp"
            android:src="@drawable/ic_line_studio"
            android:tint="#B9AFCB" />

        <TextView android:tag="krux:text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Projets &amp; Studio"
            android:textColor="#FAF7FF"
            android:textSize="15sp" />

    </LinearLayout>

    <!-- QUOTA : inchangé, placé sous la navigation -->

    <LinearLayout android:tag="krux:input"
        android:id="@+id/quotaCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_rounded_input"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <TextView android:tag="krux:text"
            android:id="@+id/tvQuotaTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Créations d'apps cette semaine"
            android:textColor="#FAF7FF"
            android:textSize="12sp" />

        <ProgressBar android:tag="krux:accent"
            android:id="@+id/quotaBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="5dp"
            android:max="100"
            android:progress="0" />

        <TextView android:tag="krux:text2"
            android:id="@+id/tvQuotaDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text=""
            android:textColor="#B9AFCB"
            android:textSize="10sp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="12dp"
        android:background="#26808080" />


    <!-- DISCUSSIONS : titre + loupe sur la même ligne -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp">

        <TextView android:tag="krux:text2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Discussions"
            android:textColor="#B9AFCB"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView android:tag="krux:text2"
            android:id="@+id/navSearchChats"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Rechercher une discussion"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_line_search"
            android:tint="#B9AFCB" />

    </LinearLayout>

    <EditText android:tag="krux:input,text,hint"
        android:id="@+id/etSearchHistory"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_rounded_input"
        android:hint="Rechercher une discussion"
        android:paddingHorizontal="13dp"
        android:textColor="#FAF7FF"
        android:textColorHint="#6F647B"
        android:textSize="13sp"
        android:visibility="gone" />


    <!-- HISTORIQUE : prend tout l'espace disponible -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:scrollbars="none" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="6dp"
        android:background="#26808080" />


    <!-- PIED : Paramètres seulement (Se déconnecter est dans Paramètres) -->

    <LinearLayout
        android:id="@+id/navCustomize"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <ImageView android:tag="krux:text2"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="14dp"
            android:src="@drawable/ic_line_settings"
            android:tint="#B9AFCB" />

        <TextView android:tag="krux:text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Paramètres"
            android:textColor="#FAF7FF"
            android:textSize="15sp" />

    </LinearLayout>

</LinearLayout>
